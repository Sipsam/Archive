# 1. 가벼운 Nginx 웹 서버를 사용합니다.
FROM nginx:alpine

# 2. 작성한 HTML/JS 파일들을 Nginx가 보여줄 수 있는 폴더로 복사합니다.
COPY . /usr/share/nginx/html

# 3. (중요) Nginx 설정 파일(nginx.conf)도 복사해서 적용합니다.
# (스크린샷에 nginx.conf 파일이 보여서 추가했습니다!)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 4. 80번 포트를 엽니다.
EXPOSE 80

# 5. Nginx 실행
CMD ["nginx", "-g", "daemon off;"]