# Copy this file to .env for local development only. Never commit real keys.
OPENAI_API_KEY=
AGENT_API_KEY=
RIOT_API_KEY=
OPENAI_MODEL=gpt-5.4
# auto, responses, or chat_completions
OPENAI_API_MODE=responses
# none, low, medium, high, or xhigh (model support varies)
OPENAI_REASONING_EFFORT=none
# Agent safety limits
MAX_AGENT_ITERATIONS=18
MAX_TOOL_CALLS=30
AGENT_TIMEOUT_SECONDS=180
# Optional API server settings
# Empty CORS origins means no browser cross-origin access is allowed.
AGENT_CORS_ORIGINS=
# Defaults to data/lol_assignment_dataset when empty.
AGENT_DATA_DIR=
# Lightweight file-based RAG over README/docs/data reference files.
ENABLE_RAG=true
RAG_INCLUDE_DATA_DOCS=true
RAG_TOP_K=4
# Shared UI/API input guardrail.
MAX_AGENT_QUERY_CHARS=12000
ENABLE_TOOL_TRACE=true
ENABLE_DEBUG_LOG=false
# Balance candidate thresholds (conservative PoC defaults)
BALANCE_MIN_SAMPLES=30
BALANCE_MIN_WIN_RATE=0.75
BALANCE_MIN_WIN_RATE_DIFF=0.20
BALANCE_MIN_WILSON_DIFF=0.0
BALANCE_FDR_ALPHA=0.05
